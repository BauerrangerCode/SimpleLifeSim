# Merged: GitHub Unreal Engine template + project-specific rules

# Visual Studio / IDE files (generated by the engine)
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
.vsconfig
*.xcodeproj
*.xcworkspace

# Compiled object files, libraries and executables
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa
*.pdb

# Packaged builds
*.pak

# Build artifacts, caches, editor-generated data
Binaries/
Plugins/**/Binaries/
Intermediate/
Plugins/**/Intermediate/
Saved/
DerivedDataCache/
*_BuiltData.uasset

# Build folder: keep packaging config (PakBlacklist, icons), ignore the rest
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Source art (not committed, see Content/Art below)
SourceArt/**/*.png
SourceArt/**/*.tga

# Claude local settings (personal, not shared)
.claude/settings.local.json

# Art assets (meshes, textures, audio, animations) are not versioned
Content/Art/

# Personal per-developer content
Content/Developers/

# Local MCP connection to the running editor (machine-specific)
.mcp.json
